FROM ubuntu
ARG USUARIO

ENV USER=${USUARIO}
# ARG PASSWORD
# RUN apt update && apt install -yq --no-install-recommends \ apache2 \ nano \ curl \ net-tools iputils-ping
# **** Instalaciones *****
RUN apt update && apt install -yq --no-install-recommends \ 
nano \
git  curl  wget \
iputils-ping net-tools \
sudo

# copiar los srcipt's del entrypoint (sc pcpal --> sc' perosonalizados)
RUN mkdir -p /root/admin/base
WORKDIR /root/admin/base
# relaitvo al directorio donde se encuentra ubbase --> docker build
# COPY ./admin/start.sh .
# relativo a la ruta del contexto Caronte en el docker-compose.yml del proyectbase
COPY ./dockerfiles/base/admin/start.sh .
# workdir dentro del contenedor
# COPY ./dockerfiles/base/admin/start.sh .
RUN chmod +x ./start.sh


# el primer comando que use el contenedor para manenerse vivo
# CMD ["tail", "-f", "/dev/null"]

ENTRYPOINT [ "./start.sh" ]
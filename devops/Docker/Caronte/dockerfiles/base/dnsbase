# Imagen base con Bind9 DNS sobre ldapbase
FROM ${INICIALES}ldapbase:latest

ENV DEBIAN_FRONTEND=noninteractive

# Instalar Bind9 (servidor DNS) e ISC DHCP
RUN apt-get update && apt-get install -y \
    bind9 \
    bind9utils \
    bind9-doc \
    isc-dhcp-server \
    && rm -rf /var/lib/apt/lists/*

# Heredar entrypoint de ldapbase
ENTRYPOINT ["/root/admin/base/start.sh"]

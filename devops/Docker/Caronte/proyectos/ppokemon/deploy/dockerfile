# --- ETAPA 1: Construcción (Node 22) ---
FROM node:22-alpine AS builder

WORKDIR /app

# Copiar dependencias
COPY src/package*.json ./
RUN npm install

# Copiar el código fuente
COPY src/ .
RUN npm run build

# --- ETAPA 2: Runtime (Ubsecurity + Node.js) ---
FROM ubsecurity:latest

# Variables de entorno
ENV USUARIO=rosa
ENV PASSWORD=1234
ENV PORT_SSH=22

# Instalar Node.js y npm
RUN apt-get update && apt-get install -y nodejs npm && rm -rf /var/lib/apt/lists/*

# Copiar aplicación construida
COPY --from=builder /app /app
WORKDIR /app

# Copiar script de arranque
COPY ./deploy/start-pokemon.sh /start-pokemon.sh
RUN chmod +x /start-pokemon.sh

# Exponer puertos (3000 para Next.js, 22 para SSH)
EXPOSE 3000 22

ENTRYPOINT ["/start-pokemon.sh"]

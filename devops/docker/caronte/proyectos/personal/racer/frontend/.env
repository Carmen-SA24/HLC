# Arduino Firebase bridge
PUERTO_USB=COM3
BAUD_RATE=9600
SERIAL_TIMEOUT=0.2
SYNC_INTERVAL_SECONDS=5
NETWORK_CHECK_TIMEOUT=1.5
PENDIENTES_FILE=pendientes.json

# Firebase Realtime Database
FIREBASE_CREDENTIALS=credenciales.json
FIREBASE_DATABASE_URL=https://proyecto-racer-default-rtdb.firebaseio.com/
FIREBASE_NODE=registros_acceso

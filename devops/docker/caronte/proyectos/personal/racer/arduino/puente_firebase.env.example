# Puerto serie del Arduino
PUERTO_USB=COM3
BAUD_RATE=9600
SERIAL_TIMEOUT=0.2

# Firebase Realtime Database
FIREBASE_CREDENTIALS=credenciales.json
FIREBASE_DATABASE_URL=https://TU-PROYECTO-rtdb.europe-west1.firebasedatabase.app/
FIREBASE_NODE=registros_acceso

# Cola local y sincronización
PENDIENTES_FILE=pendientes.json
SYNC_INTERVAL_SECONDS=5
NETWORK_CHECK_TIMEOUT=1.5

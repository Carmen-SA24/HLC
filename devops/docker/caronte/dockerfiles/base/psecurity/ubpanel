# Panel web de administración Cockpit
ARG INICIALES=crsa
FROM ${INICIALES}ubbase

# Instalar Cockpit
RUN apt-get update && apt-get install -y \
    cockpit \
    cockpit-podman \
    cockpit-networkmanager \
    cockpit-storaged \
    cockpit-packagekit \
    && rm -rf /var/lib/apt/lists/*

# Habilitar Cockpit
RUN systemctl enable cockpit.socket || true

# Crear scripts de configuración
RUN mkdir -p /root/admin/panel
COPY ./dockerfiles/base/admin/panel/config.sh /root/admin/panel/
COPY ./dockerfiles/base/admin/panel/start.sh /start.sh
RUN chmod +x /root/admin/panel/config.sh /start.sh

# Puertos: Cockpit web(9090), SSH(22)
EXPOSE 9090 22

ENTRYPOINT ["/start.sh"]

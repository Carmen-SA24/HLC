#Imagen base de apache con ubuntu actualizado
FROM ubuntu

#Instalacion de paquetes ejje
RUN apt update && apt install -yq --no-install-recommends \
    nano \
    curl \
    net-tools iputils-ping \
    sudo \
    openssh-server

# Copiar scripts de administración y configuración
RUN mkdir -p /root/admin/base
WORKDIR /root/admin/base
COPY ./dockerfiles/base/admin/ .
COPY ./common/id_ed25519.pub /root/admin/base/common/id_ed25519.pub
COPY ./dockerfiles/base/admin/start.sh .
RUN chmod +x ./start.sh
RUN chmod +x ./ciber/*.sh 2>/dev/null || true

ENTRYPOINT [ "./start.sh" ]
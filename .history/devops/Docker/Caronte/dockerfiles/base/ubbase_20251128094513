FROM ubuntu

RUN apt update && apt install -yq --no-install-recommends \
    nano \
    git \
    curl \
    wget \
    iputils-ping \
    net-tools \
    sudo \
    openssh-server

# Crear carpeta para tus scripts
RUN mkdir -p /root/admin/base
WORKDIR /root/admin/base

# Copiar scripts del entrypoint
COPY ./dockerfiles/base/admin .
# Copiar la clave pública en la misma carpeta donde está el script
COPY ./common/id_ed25519.pub /root/admin/base/id_ed25519.pub
COPY ./dockerfiles/base/admin/star
RUN chmod +x ./start.sh

ENTRYPOINT ["./start.sh"]